<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="./favicon.svg" />
<title>Zhengjie — AI & Data Engineer</title>
<style>
:root{
  --bg:#f7f7f3;
  --panel:#fbfbf8;
  --text:#14191d;
  --muted:#6d767d;
  --line:#d8dddc;
  --line2:#e8ebe9;
  --teal:#1b858b;
  --orange:#ee5b24;
  --blue:#577db3;
  --shadow:0 14px 36px rgba(22,30,35,.055);
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
  --sans:"Aptos","Segoe UI Variable Text","Segoe UI","Helvetica Neue",Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);letter-spacing:.01em}
a{color:inherit;text-decoration:none}
.shell{min-height:100vh}
.topbar{position:sticky;top:0;z-index:20;border-bottom:1px solid var(--line);background:rgba(247,247,243,.94);backdrop-filter:blur(12px)}
.topbar-inner{max-width:1280px;margin:0 auto;padding:14px 42px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:32px}
.identity{display:flex;align-items:baseline;gap:12px;white-space:nowrap}
.home-identity{opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-3px);transition:opacity .2s ease,transform .2s ease,visibility 0s linear .2s}.home-identity.is-visible{opacity:1;visibility:visible;pointer-events:auto;transform:none;transition-delay:0s}
.brand{font:700 20px/1 var(--sans);letter-spacing:-.025em}.brand i{display:inline-block;width:14px;height:2px;background:var(--orange);margin-left:5px;vertical-align:middle}
.brand-sub{font:9px var(--mono);color:#687178;letter-spacing:.11em;text-transform:uppercase}
.nav{display:flex;align-items:center;justify-content:center;gap:4px}
.nav a{display:flex;align-items:center;gap:7px;padding:9px 12px;font:10px var(--mono);text-transform:uppercase;border-radius:2px}
.nav a:hover,.nav a:focus-visible{background:var(--line2);outline:none}
.nav .n{color:#8a9296;font-size:8px}.nav a.active{color:var(--orange)}.nav .arrow{font-size:13px}
.topbar-meta{display:flex;align-items:center;gap:14px;font:9px var(--mono);color:#667178;text-transform:uppercase;white-space:nowrap}
.topbar-meta .status{color:#3f4a4f}.topbar-meta .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#1ba86c;margin-right:6px}
.main{max-width:1280px;width:100%;margin:0 auto;padding:0 42px 58px}
.main section[id],.main footer[id]{scroll-margin-top:84px}
.hero{min-height:650px;padding-top:20px;display:grid;grid-template-columns:minmax(340px,.82fr) minmax(620px,1.18fr);gap:44px;align-items:center;border-bottom:1px solid var(--line);position:relative}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(to right,rgba(30,55,60,.033) 1px,transparent 1px),linear-gradient(to bottom,rgba(30,55,60,.033) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to right,transparent 0,#000 32%,#000 100%);pointer-events:none}
.hero-copy{position:relative;z-index:1;padding-left:4px}
h1{font-size:74px;line-height:.92;letter-spacing:-.045em;margin:0 0 19px;font-weight:760}
.role{font:23px/1.1 var(--mono);font-weight:700;color:var(--orange);letter-spacing:.01em;margin-bottom:21px}
.focus{font:11px var(--mono);text-transform:uppercase;color:#3e5559;display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px}.focus b{color:var(--teal)}
.lede{font:17px/1.58 var(--sans);max-width:430px;color:#333b40;margin:0 0 28px}.cta{display:inline-flex;align-items:center;gap:14px;font:12px var(--mono);font-weight:700;text-transform:uppercase;color:var(--teal);padding-bottom:7px;border-bottom:1px solid var(--teal)}.cta span{color:var(--orange);font-size:17px}
.system-map{position:relative;z-index:1;background:rgba(250,251,248,.72);border:1px solid var(--line);box-shadow:var(--shadow);padding:20px 20px 18px;backdrop-filter:blur(3px)}
.map-head{display:flex;align-items:flex-end;justify-content:space-between;padding:4px 4px 13px;border-bottom:1px solid var(--line)}
.map-title{font:13px var(--mono);font-weight:700}.map-note{font:9px var(--mono);color:var(--muted);letter-spacing:.07em;text-transform:uppercase}
.lane{display:grid;grid-template-columns:86px 1fr;min-height:132px;border-bottom:1px solid var(--line2)}.lane:last-of-type{border-bottom:0}
.lane-label{padding:24px 10px 18px 5px;border-right:1px solid var(--line2)}.lane-label strong{font:12px var(--mono);display:block;margin-bottom:5px}.lane-label span{font:9px/1.45 var(--mono);color:var(--muted)}
.flow{display:grid;grid-template-columns:1fr 24px 1fr 24px 1fr 24px 1fr;align-items:center;padding:15px 7px 14px 14px}
.node{min-height:84px;border:1px solid #cfd5d3;background:rgba(255,255,255,.6);padding:10px 9px;position:relative;overflow:hidden}.node::after{content:"";position:absolute;left:0;top:0;width:3px;height:100%;background:var(--teal);opacity:.72}.lane.sim .node::after{background:var(--orange)}.lane.audio .node::after{background:var(--blue)}
.node .k{font:8px var(--mono);color:var(--muted);text-transform:uppercase;margin-bottom:8px}.node .v{font:11px/1.25 var(--mono);font-weight:700}.node .mini{font:8px/1.45 var(--mono);color:#687279;margin-top:7px}
.edge{height:1px;background:#aeb8b7;position:relative}.edge::after{content:"";position:absolute;right:-1px;top:-3px;border-left:5px solid var(--orange);border-top:3px solid transparent;border-bottom:3px solid transparent}.edge .pulse{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--teal);top:-2px;left:0;animation:travel 3.2s linear infinite}.sim .edge .pulse{background:var(--orange);animation-delay:.8s}.audio .edge .pulse{background:var(--blue);animation-delay:1.6s}
@keyframes travel{from{left:0}to{left:calc(100% - 4px)}}
.map-foot{border-top:1px solid var(--line);margin-top:6px;padding:10px 4px 1px;display:flex;justify-content:space-between;font:8px var(--mono);color:#727b80;text-transform:uppercase}
.section{padding:34px 0 0}.section-head{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:13px;margin-bottom:0}.section-head h2{font:17px var(--mono);margin:0;text-transform:uppercase}.section-head a{font:10px var(--mono);color:var(--teal)}
.project{display:grid;grid-template-columns:76px 270px minmax(260px,1fr) 120px;gap:22px;padding:22px 0;border-bottom:1px solid var(--line);align-items:stretch;position:relative;transition:background .18s ease}.project:hover{background:rgba(232,235,233,.42)}.project-link{position:absolute;inset:0;z-index:2}.project-link:focus-visible{outline:2px solid var(--teal);outline-offset:-2px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.project-num{font:38px var(--mono);color:var(--teal);line-height:1}.project-num small{display:block;font:8px/1.55 var(--mono);color:#596368;margin-top:12px;text-transform:uppercase}.project-visual{height:170px;border:1px solid #ccd3d1;background:#f1f4f3;position:relative;overflow:hidden}.project-text h3{font:650 23px/1.15 var(--sans);margin:3px 0 12px;letter-spacing:-.015em}.project-text p{font:13px/1.6 var(--sans);color:#4e585d;max-width:520px}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:15px}.tags span{border:1px solid #cfd5d3;padding:4px 7px;font:8px var(--mono);text-transform:uppercase;background:#fafbf8}.pipeline{border-left:1px solid var(--line);padding-left:17px;display:flex;flex-direction:column;justify-content:center;gap:9px;font:9px/1.2 var(--mono);text-align:center}.pipeline i{height:16px;width:1px;background:#aab2b1;margin:0 auto;position:relative}.pipeline i::after{content:"";position:absolute;bottom:-1px;left:-3px;width:5px;height:5px;border-right:1px solid #6b7779;border-bottom:1px solid #6b7779;transform:rotate(45deg)}
/* code-native mini visuals */
.mini-dashboard{position:absolute;inset:12px;display:grid;grid-template-columns:46px 1fr;gap:7px}.mini-side{background:#232c32;border-radius:2px;padding:10px 6px}.mini-side b,.mini-side i{display:block;height:3px;background:#59666d;margin-bottom:8px;border-radius:2px}.mini-side b{background:var(--orange);width:70%}.mini-main{display:grid;grid-template-rows:28px 1fr;gap:7px}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.kpis i{border:1px solid #d3d9d7;background:#fff}.chart{border:1px solid #d3d9d7;background:#fff;position:relative}.chart svg{position:absolute;inset:9px;width:calc(100% - 18px);height:calc(100% - 18px)}
.auralization-visual{padding:0;background:#f6f7f3;overflow:hidden}.auralization-svg{width:100%;height:100%;display:block}
.speech-vis{display:grid;grid-template-columns:1fr 1fr;height:100%}.mfcc{background:linear-gradient(180deg,#092a4b,#15487b 35%,#f0a030 78%,#111c37);position:relative}.mfcc::after{content:"";position:absolute;inset:12px;background:repeating-linear-gradient(90deg,transparent 0 8px,rgba(255,255,255,.17) 9px 10px),repeating-linear-gradient(0deg,transparent 0 12px,rgba(0,0,0,.18) 13px 14px);mix-blend-mode:screen}.wave{position:relative;background:#f7f8f6}.wave svg{position:absolute;inset:20px 10px 70px;width:calc(100% - 20px);height:70px}.cnn-stack{position:absolute;left:18px;right:18px;bottom:13px;display:flex;align-items:flex-end;gap:5px}.cnn-stack i{display:block;width:28px;border:1px solid #99a9b3;background:rgba(87,125,179,.12)}.cnn-stack i:nth-child(1){height:16px}.cnn-stack i:nth-child(2){height:24px}.cnn-stack i:nth-child(3){height:33px}.cnn-stack i:nth-child(4){height:43px}
.summary{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line);margin-top:34px}.summary div{padding:24px 20px;border-right:1px solid var(--line)}.summary div:last-child{border-right:0}.summary strong{display:block;font:25px var(--mono);color:var(--teal);margin-bottom:5px}.summary span{font:9px/1.45 var(--mono);text-transform:uppercase;color:#596368}
.skills{padding:29px 0 0}.skills h2{font:15px var(--mono);text-transform:uppercase;border-bottom:1px solid var(--line);padding-bottom:11px}.skill-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}.skill-col{padding:9px 22px 10px 0;border-right:1px solid var(--line)}.skill-col:not(:first-child){padding-left:24px}.skill-col:last-child{border-right:0}.skill-col h4{font:10px var(--mono);text-transform:uppercase;color:var(--teal);margin:0 0 10px}.skill-col p{font:10px/1.75 var(--mono);color:#4f595e;margin:0}
.footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);margin-top:34px;padding:22px 0 0;font:9px var(--mono);text-transform:uppercase;color:#5f696d}.footer-contact{display:flex;align-items:center;gap:14px}.footer-contact a{padding-bottom:5px;border-bottom:1px solid var(--teal);color:var(--teal);font-size:11px;text-transform:none}.footer-contact a:hover,.footer-contact a:focus-visible{color:var(--orange);border-color:var(--orange);outline:none}.footer .accent{color:var(--orange)}
@media(max-width:980px){.topbar-inner{grid-template-columns:1fr auto;gap:8px 18px;padding:12px 22px 0}.nav{grid-column:1/-1;justify-content:space-between;padding-bottom:10px}.nav a{padding:8px 4px}.nav .n,.nav .arrow{display:none}.topbar-meta{grid-column:2;grid-row:1}.topbar-meta>span:last-child{display:none}.main{padding:0 22px 48px}.main section[id],.main footer[id]{scroll-margin-top:100px}.hero{grid-template-columns:1fr;gap:28px;padding:54px 0}.system-map{margin-bottom:22px}.project{grid-template-columns:60px 1fr}.project-visual,.project-text{grid-column:2}.pipeline{display:none}.summary{grid-template-columns:repeat(2,1fr)}.skill-grid{grid-template-columns:repeat(2,1fr)}.skill-col{border-right:0;border-bottom:1px solid var(--line);padding:18px 0!important}h1{font-size:56px}.flow{grid-template-columns:1fr 16px 1fr 16px 1fr 16px 1fr}.node{min-height:74px;padding:8px 7px}.node .mini{display:none}}
@media(max-width:600px){.brand-sub{display:none}.nav a{font-size:9px}.system-map{padding:16px 12px}.map-head{align-items:flex-start;gap:12px}.map-note{text-align:right}.lane{grid-template-columns:72px minmax(0,1fr)}.lane-label{padding-left:2px}.flow{grid-template-columns:110px 16px 110px 16px 110px 16px 110px;overflow-x:auto;scrollbar-width:none}.flow::-webkit-scrollbar{display:none}.node{min-height:88px}.node .mini{display:block}.map-foot{gap:14px;line-height:1.45}.footer{align-items:flex-start;flex-direction:column;gap:16px}.footer-contact{flex-wrap:wrap}}

/* experience + education timeline */
.timeline-section{padding:44px 0 0}
.timeline-head{display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:19px 0 16px}
.timeline-head h2{font:17px var(--mono);margin:0;text-transform:uppercase;letter-spacing:.01em}
.timeline-head span{font:10px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.timeline-list{position:relative}
.timeline-row{display:grid;grid-template-columns:96px 34px minmax(0,1fr) 112px;min-height:210px;border-bottom:1px solid var(--line);position:relative;align-items:stretch}
.timeline-date{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:8px;padding:26px 8px 26px 10px;font:10px/1 var(--mono);color:#687278;letter-spacing:.035em}
.timeline-date .date-line{width:20px;height:1px;background:#b8c0bf}
.timeline-rail{position:relative;border-left:1px solid var(--line);margin-left:12px}
.timeline-dot{position:absolute;left:-5px;top:50%;width:9px;height:9px;border:1px solid #9da7a8;background:var(--bg);transform:translateY(-50%)}
.timeline-row.experience .timeline-dot{border-color:var(--orange);background:var(--orange)}
.timeline-body{display:flex;flex-direction:column;justify-content:center;padding:30px 32px 30px 24px;min-width:0}
.timeline-body h3{font:650 27px/1.12 var(--sans);margin:0 0 6px;letter-spacing:-.018em}
.timeline-sub{font:15px/1.35 var(--sans);color:#667075;margin-bottom:22px}
.timeline-detail{display:grid;grid-template-columns:56px minmax(0,1fr);align-items:center;gap:10px;margin-top:10px;max-width:820px}
.timeline-detail b{font:10px var(--mono);font-weight:500;color:#7c8589;text-transform:uppercase}
.timeline-detail p{font:13px/1.55 var(--sans);color:#5c656a;margin:0}
.timeline-type{display:flex;align-items:center;justify-content:flex-end;padding:26px 0;font:10px var(--mono);color:#7a8387;text-transform:uppercase;letter-spacing:.06em}
@media(max-width:980px){.timeline-head span{display:none}.timeline-row{grid-template-columns:76px 28px minmax(0,1fr);min-height:auto}.timeline-date{grid-column:1;grid-row:1/3;padding:24px 6px 24px 0;align-items:flex-start}.timeline-rail{grid-column:2;grid-row:1/3;margin-left:8px}.timeline-body{grid-column:3;padding:26px 0 10px 18px}.timeline-type{grid-column:3;padding:0 0 24px 18px;justify-content:flex-start;color:var(--teal)}.timeline-body h3{font-size:23px}.timeline-detail{grid-template-columns:1fr;gap:4px}}

@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.pulse{animation:none!important}.home-identity{transition:none}}
</style>
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="identity home-identity" href="#home" aria-label="Zhengjie portfolio home" aria-hidden="true" inert>
        <span class="brand">Zhengjie<i></i></span>
        <span class="brand-sub">Portfolio</span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a class="active" href="#home"><span class="n">01</span><span>Home</span><span class="arrow">→</span></a>
        <a href="#work"><span class="n">02</span><span>Work</span></a>
        <a href="#experience"><span class="n">03</span><span>Experience</span></a>
        <a href="#skills"><span class="n">04</span><span>Skills</span></a>
        <a href="#contact"><span class="n">05</span><span>Contact</span></a>
      </nav>
      <div class="topbar-meta">
        <span class="status"><span class="dot"></span>Available</span>
        <span>Aachen, Germany</span>
      </div>
    </div>
  </header>
  <main class="main">
    <section class="hero" id="home">
      <div class="hero-copy">
        <h1>Zhengjie</h1>
        <div class="role">AI &amp; DATA ENGINEER</div>
        <div class="focus"><b>AI SYSTEMS</b><span>/</span><b>DATA WORKFLOWS</b><span>/</span><b>SIMULATION</b></div>
        <p class="lede">I build practical systems that turn real-world data, simulations and signals into usable engineering outcomes.</p>
        <a class="cta" href="#work">Explore selected work <span>→</span></a>
      </div>

      <div class="system-map" aria-label="Project-informed engineering system map">
        <div class="map-head"><div class="map-title">SYSTEM MAP / THREE REAL WORKFLOWS</div><div class="map-note">code-native schematic</div></div>

        <div class="lane data">
          <div class="lane-label"><strong>DATA / AI</strong><span>Bakery analytics platform</span></div>
          <div class="flow">
            <div class="node"><div class="k">Inputs</div><div class="v">POS + Weather</div><div class="mini">sales · loss · member · external</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Processing</div><div class="v">Clean + Analyze</div><div class="mini">Pandas · business logic</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Intelligence</div><div class="v">Agent + Forecast</div><div class="mini">LangGraph · XGBoost</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Output</div><div class="v">Dashboard + Insight</div><div class="mini">Streamlit · Plotly</div></div>
          </div>
        </div>

        <div class="lane sim">
          <div class="lane-label"><strong>SIMULATION</strong><span>Road traffic auralization</span></div>
          <div class="flow">
            <div class="node"><div class="k">Traffic</div><div class="v">SUMO FCD / CSV</div><div class="mini">routes · trajectories</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Geometry</div><div class="v">Trajectory Transform</div><div class="mini">parse · interpolate · orient</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Acoustics</div><div class="v">RAVEN / Pigeon</div><div class="mini">3D propagation simulation</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Audio</div><div class="v">Synthesis + Eval</div><div class="mini">crossfade · mix · listening</div></div>
          </div>
        </div>

        <div class="lane audio">
          <div class="lane-label"><strong>AUDIO ML</strong><span>Spoken digit CNN</span></div>
          <div class="flow">
            <div class="node"><div class="k">Signal</div><div class="v">Speech WAV</div><div class="mini">FSDD + own recordings</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Features</div><div class="v">MFCC</div><div class="mini">librosa · fixed input</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Model</div><div class="v">1D / 2D CNN</div><div class="mini">TensorFlow · Keras</div></div>
            <div class="edge"><i class="pulse"></i></div>
            <div class="node"><div class="k">Inference</div><div class="v">Digit 0–9</div><div class="mini">test set + live mic</div></div>
          </div>
        </div>
        <div class="map-foot"><span>DATA → PROCESS → MODEL → OUTPUT</span><span>THREE DOMAINS / ONE ENGINEERING MINDSET</span></div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="section-head"><h2>Selected Work</h2><a href="./work/bakery-ai-analytics/index.html">CASE STUDIES →</a></div>

      <article class="project">
        <a class="project-link" href="./work/bakery-ai-analytics/index.html" aria-label="View case study: Bakery AI Analytics Platform"><span class="sr-only">View case study</span></a>
        <div class="project-num">01<small>Applied AI<br/>Data system</small></div>
        <div class="project-visual">
          <div class="mini-dashboard"><div class="mini-side"><b></b><i></i><i></i><i></i><i></i></div><div class="mini-main"><div class="kpis"><i></i><i></i><i></i><i></i></div><div class="chart"><svg viewBox="0 0 210 100" preserveAspectRatio="none"><polyline fill="none" stroke="#1b858b" stroke-width="2" points="0,78 24,67 49,72 72,50 98,56 121,31 144,37 170,22 210,15"/><polyline fill="none" stroke="#ee5b24" stroke-width="1" opacity=".65" points="0,88 33,80 63,83 90,70 121,72 152,61 183,58 210,49"/></svg></div></div></div>
        </div>
        <div class="project-text"><h3>Bakery AI Analytics Platform</h3><p>Modular Streamlit analytics platform combining data loading, business analysis, forecasting and a LangGraph ReAct assistant with tool-based querying and visualization. Business values are intentionally not shown here.</p><div class="tags"><span>Python</span><span>LangGraph</span><span>Streamlit</span><span>XGBoost</span></div></div>
        <div class="pipeline"><span>DATA</span><i></i><span>ANALYSIS</span><i></i><span>AGENT</span><i></i><span>INSIGHT</span></div>
      </article>

      <article class="project">
        <a class="project-link" href="./work/road-traffic-auralization/index.html" aria-label="View case study: Plausible Road Traffic Auralization"><span class="sr-only">View case study</span></a>
        <div class="project-num">02<small>Simulation<br/>Research</small></div>

<div class="project-visual auralization-visual" aria-label="HTML rendered German road traffic auralization schematic">
<svg class="auralization-svg" viewBox="0 0 1000 560" role="img" aria-labelledby="aur-title aur-desc">
  <title id="aur-title">Plausible road traffic auralization — 2D top view</title>
  <desc id="aur-desc">Two-dimensional top-view engineering schematic of a German two-way urban road with right-hand traffic, a source vehicle, an opposing vehicle, a roadside receiver, a direct acoustic path and two building-reflection paths.</desc>

  <defs>
