<script>
  const homeIdentity = document.querySelector('.home-identity');
  const heroName = document.querySelector('.hero-copy h1');

  if (homeIdentity instanceof HTMLElement && heroName instanceof HTMLElement) {
    const setHomeIdentityVisible = (visible: boolean) => {
      homeIdentity.classList.toggle('is-visible', visible);
      homeIdentity.setAttribute('aria-hidden', String(!visible));
      homeIdentity.inert = !visible;
    };

    const nameRect = heroName.getBoundingClientRect();
    setHomeIdentityVisible(nameRect.bottom <= 64 || nameRect.top >= window.innerHeight);

    const nameObserver = new IntersectionObserver(
      ([entry]) => setHomeIdentityVisible(!entry.isIntersecting),
      { rootMargin: '-64px 0px 0px 0px', threshold: 0 },
    );
    nameObserver.observe(heroName);
  }
</script>
